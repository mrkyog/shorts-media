{
  "id": "golden-record",
  "title": "Voyager's Golden Record: Earth's message to aliens",
  "voice": "af_heart",
  "speed": 1.0,
  "lead_in": 0.15,
  "tail": 0.9,
  "lines": [
    {"id": "L1",  "gap": 0.24, "text": "There's a / golden record / flying out of / our solar system."},
    {"id": "L2",  "gap": 0.30, "text": "It rides on / Voyager {One,|1,} / and a copy / flies on / Voyager {Two.|2.}"},
    {"id": "L3",  "gap": 0.30, "text": "A {twelve-inch|12-inch} / gold-plated disc, / made for / whoever / finds it."},
    {"id": "L4",  "gap": 0.30, "text": "It says hello / in {fifty-five|55} languages, / from ancient / Akkadian / to modern / Chinese."},
    {"id": "L5",  "gap": 0.30, "text": "It hides / {one hundred fifteen|115} pictures / in its grooves."},
    {"id": "L6",  "gap": 0.32, "text": "Thunder, / whales, / birdsong, / and {ninety|90} minutes / of music."},
    {"id": "L7",  "gap": 0.30, "text": "The cover / shows how / to play it, / and a map / to our Sun, / using {fourteen|14} pulsars."},
    {"id": "L8",  "gap": 0.32, "text": "There's even / a speck / of uranium, / a clock / to tell / how long ago / it left."},
    {"id": "L9",  "gap": 0.36, "text": "And Voyager {One|1} / won't come within / {two|2} light-years / of another star / for about / {forty thousand|40,000} years."},
    {"id": "L10", "gap": 0.0,  "text": "Follow for / part {three:|3:} / the photo / Voyager took / of us, / from the dark."}
  ],
